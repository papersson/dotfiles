<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Nightly refresh of the folder cache that `media status` and `media hook` read. -->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.patrikpersson.media-scan</string>
  <key>ProgramArguments</key>
  <array>
    <string>/Users/patrikpersson/.local/bin/media</string>
    <string>scan</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
  </dict>
  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key>
    <integer>3</integer>
    <key>Minute</key>
    <integer>30</integer>
  </dict>
  <key>LowPriorityIO</key>
  <true/>
  <key>Nice</key>
  <integer>10</integer>
  <key>StandardOutPath</key>
  <string>/Users/patrikpersson/.local/state/media/scan.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/patrikpersson/.local/state/media/scan.log</string>
</dict>
</plist>
